def partition_stable(pred, lst):
    true_group = []
    false_group = []
    for x in lst:
        if pred(x):
            true_group.append(x)
        else:
            false_group.append(x)
    return (true_group, false_group)
def is_even(n):
    return n%2==0
def always_true(x):
    return True
def always_false(x):
    return False
assert partition_stable(is_even, [1, 2, 3, 4]) == ([2, 4], [1, 3])
assert partition_stable(always_true, []) == ([], [])
assert partition_stable(always_false, [1, 2]) == ([], [1, 2])
src = [5, 2, 7, 4, 2, 9]
t, f = partition_stable(is_even, src)
assert t == [2, 4, 2] and f == [5, 7, 9]
assert src == [5, 2, 7, 4, 2, 9]
print("Все тесты пройдены")
